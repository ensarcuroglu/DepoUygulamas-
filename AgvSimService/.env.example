# ==============================================================================
# AGV SIMULASYON SERVISI - ORTAM DEGISKENLERI SABLONU (.env.example)
# ==============================================================================
# Bu dosyayi .env adiyla kopyalayin ve kendi degerlerinizle doldurun.
# .env dosyasi ASLA git'e push edilmemelidir.

# 1. WMS BAGLANTISI (BackendProje)
# ------------------------------------------------------------------------------
# AGV gorev tamamlandiginda BackendProje'ye callback atilir.
WMS_BASE_URL=http://127.0.0.1:8000

# 2. SERVISLER ARASI KIMLIK
# ------------------------------------------------------------------------------
# BackendProje'nin INTERNAL_API_KEY ile AYNI deger olmalidir.
# Oneri: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=

# 3. SIMULASYON AYARLARI
# ------------------------------------------------------------------------------
# Tick loop frekansi (Hz). 2 = yavas/gozlemlenebilir, 5-10 = gercek-zaman.
# Frontend useFrame 60 FPS lerp interpolasyon yapar; tick frekansi gorsel
# akiskanligi etkilemez sadece olaylarin gerceklesme hizini etkiler.
TICK_HZ=2

# 4. CORS
# ------------------------------------------------------------------------------
# Virgulle ayrilmis origin listesi (frontend Vite dev server).
CORS_ALLOW_ORIGINS=https://localhost:5173

# 5. GRID KAYNAGI (Faz 1)
# ------------------------------------------------------------------------------
# json = elle hazirlanmis dosya (MVP)
# wms  = BackendProje API'sinden depo + raf bilgisi cek (Faz 2+)
GRID_KAYNAGI=json
GRID_JSON_PATH=./data/depo_1_grid.json

# 6. WEBSOCKET KORUMASI
# ------------------------------------------------------------------------------
# Yavas client koruma: kuyruk bu sayiyi asarsa bagli client kapatilir.
WS_MAX_QUEUE=32
