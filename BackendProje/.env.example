# ==============================================================================
# DEPO YÖNETİM SİSTEMİ - ORTAM DEĞİŞKENLERİ ŞABLONU (.env.example)
# ==============================================================================
# Bu dosyayı .env adıyla kopyalayın ve kendi değerlerinizle doldurun.
# .env dosyası ASLA git'e push edilmemelidir!

# 1. VERİTABANI BAĞLANTISI (MySQL)
# ------------------------------------------------------------------------------
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=depo_db

# 2. GÜVENLİK (JWT)
# ------------------------------------------------------------------------------
# ÖNEMLİ: Üretim ortamında mutlaka karmaşık ve uzun bir anahtar kullanın!
# Öneri: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# 3. E-POSTA AYARLARI (SMTP) - Zamanlı raporlar için
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@depoyonetim.com

# 4. PUTAWAY TIMEOUT (dakika — ATANDI görevlerin otomatik serbest bırakılma süresi)
# ------------------------------------------------------------------------------
PUTAWAY_TIMEOUT=60

# 5. PALET VERİ KAYNAĞI SEÇİMİ
# ------------------------------------------------------------------------------
# LOCAL  = Mal Kabul İrsaliyesi'nden okur (varsayılan, mevcut akış)
# MOCK   = Demo/geliştirme için sahte ERP verisi döner
# ERP    = Gerçek ERP API'ye bağlanır (aşağıdaki ayarlar gerekli)
PALET_VERI_KAYNAGI=LOCAL

# 5. ERP ENTEGRASYON AYARLARI (sadece PALET_VERI_KAYNAGI=ERP ise gerekli)
# ------------------------------------------------------------------------------
ERP_API_URL=
ERP_API_KEY=
ERP_TIMEOUT=30
