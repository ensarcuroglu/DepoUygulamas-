# ==============================================================================
# DEPO YONETIM SISTEMI - ORTAM DEGISKENLERI SABLONU (.env.example)
# ==============================================================================
# Bu dosyayi .env adiyla kopyalayin ve kendi degerlerinizle doldurun.
# .env dosyasi ASLA git'e push edilmemelidir.

# 1. VERITABANI BAGLANTISI (MySQL)
# ------------------------------------------------------------------------------
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=depo_db

# 2. GUVENLIK (JWT)
# ------------------------------------------------------------------------------
# Uretimde mutlaka karmasik ve uzun bir anahtar kullanin.
# Oneri: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# 3. CORS
# ------------------------------------------------------------------------------
# Virgulle ayrilmis origin listesi.
CORS_ALLOW_ORIGINS=https://localhost:5173,http://localhost:3000

# 4. E-POSTA AYARLARI (SMTP) - Zamanli raporlar icin
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@depoyonetim.com

# 5. PUTAWAY VE STAGING AYARLARI
# ------------------------------------------------------------------------------
# Dakika cinsinden ATANDI gorevlerin otomatik serbest birakilma suresi.
PUTAWAY_TIMEOUT=60

# Saat cinsinden staging uyarisi esigi.
STAGING_UYARI_ESIK_SAAT=24

# 6. FEATURE FLAGS
# ------------------------------------------------------------------------------
# Bos    = uretim paleti ozelligi tum depolar icin kapali
# TUMU   = tum depolar icin acik
# 1,3,5  = sadece belirtilen depo ID'leri icin acik
FEATURE_URETIM_PALET_PILOT_DEPO_IDS=

# 7. PALET VERI KAYNAGI SECIMI
# ------------------------------------------------------------------------------
# LOCAL = Mal Kabul Irsaliyesi'nden okur (varsayilan, mevcut akis)
# MOCK  = Demo/gelistirme icin sahte ERP verisi doner
# ERP   = Gercek ERP API'ye baglanir (asagidaki ayarlar gerekli)
PALET_VERI_KAYNAGI=LOCAL

# 8. ERP ENTEGRASYON AYARLARI (sadece PALET_VERI_KAYNAGI=ERP ise gerekli)
# ------------------------------------------------------------------------------
ERP_API_URL=
ERP_API_KEY=
ERP_TIMEOUT=30

# 9. YARDIMCI SCRIPT AYARLARI
# ------------------------------------------------------------------------------
# clean_test_data.py icin ek izinli veritabani adlari. Virgulle ayirin.
CLEAN_TEST_DATA_ALLOWED_DBS=
