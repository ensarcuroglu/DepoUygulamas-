# Docker Compose development defaults.
# This file is intentionally tracked and contains local-only convenience values.

MYSQL_ROOT_PASSWORD=depo_root_dev
MYSQL_DATABASE=depo_yonetim

DB_HOST=mysql
DB_PORT=3306
DB_NAME=depo_yonetim
DB_USER=depo_app
DB_PASSWORD=depo_app_dev

JWT_SECRET_KEY=dev-only-jwt-secret-key-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

INTERNAL_API_KEY=dev-only-internal-api-key-change-me-0123456789abcdef

CORS_ALLOW_ORIGINS=http://localhost:5173,https://localhost:5173,http://127.0.0.1:5173,https://127.0.0.1:5173

FEATURE_URETIM_PALET_PILOT_DEPO_IDS=TUMU
FEATURE_AGV_DISPATCH_DEPO_IDS=TUMU
FEATURE_DOC_AI_PILOT_DEPO_IDS=TUMU

PALET_VERI_KAYNAGI=LOCAL
AGV_SIM_SERVICE_URL=http://agv-sim:8002
AGV_SIM_SERVICE_TIMEOUT=2.0
DOC_AI_SERVICE_URL=http://doc-ai:8003
DOC_AI_SERVICE_TIMEOUT=120
WMS_AI_SERVICE_URL=http://wms-ai:8001
WMS_AI_SERVICE_TIMEOUT=180

WMS_BASE_URL=http://backend:8000
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_ANSWER_MODEL=qwen2.5-coder:7b
OLLAMA_TEXT_MODEL=qwen3-vl:4b
OLLAMA_VLM_MODEL=qwen3-vl:4b
LLM_TIMEOUT=120

TICK_HZ=2
GRID_KAYNAGI=json
GRID_JSON_PATH=./data/depo_1_grid.json
WS_MAX_QUEUE=32

VITE_FEATURE_AGV_ENABLED=true
VITE_FEATURE_DOC_AI_ENABLED=true
VITE_FEATURE_URETIM_PALET_ENABLED=true
VITE_BACKEND_PROXY_TARGET=http://backend:8000
VITE_AGV_PROXY_TARGET=http://agv-sim:8002
VITE_AGV_WS_PROXY_TARGET=ws://agv-sim:8002
VITE_DEV_HTTPS=false

WATCHFILES_FORCE_POLLING=true
WATCHFILES_IGNORE_PERMISSION_DENIED=true
CHOKIDAR_USEPOLLING=true

RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=depo.events
RABBITMQ_QUEUE=depo.lms.operator_metrikleri
RABBITMQ_DLX=depo.events.dlx
RABBITMQ_PREFETCH=20
RABBITMQ_RELAY_BATCH_SIZE=100
