# ==============================================================================
# DOC AI SERVICE - ORTAM DEGISKENLERI SABLONU (.env.example)
# ==============================================================================
# Bu dosyayi .env adiyla kopyalayin ve kendi degerlerinizle doldurun.
# .env dosyasi ASLA git'e push edilmemelidir.

# 1. SERVISLER ARASI KIMLIK
# ------------------------------------------------------------------------------
# BackendProje'nin INTERNAL_API_KEY degeri ile AYNI olmalidir.
# Oneri: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=

# 2. WMS BAGLANTISI (BackendProje)
# ------------------------------------------------------------------------------
WMS_BASE_URL=http://127.0.0.1:8000

# 3. OLLAMA / LLM AYARLARI
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=qwen2.5:7b
OLLAMA_VLM_MODEL=qwen2.5-vl:7b
LLM_TIMEOUT=120

# 4. DOSYA LIMITLERI
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_MB=25

# 5. CORS
# ------------------------------------------------------------------------------
# Virgulle ayrilmis origin listesi.
CORS_ALLOW_ORIGINS=https://localhost:5173
